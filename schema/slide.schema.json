{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktsmm.github.io/m365-copilot-update-digest/schema/slide.schema.json",
  "title": "M365 Copilot update slide (1 update = 1 slide)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "kind", "label", "title", "meta", "references", "inputFingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "kind": { "enum": ["ga", "preview", "rolling-out", "in-development", "retirement", "update"] },
    "label": { "type": "string", "minLength": 1, "maxLength": 20 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja"],
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 200 },
        "en": { "type": "string", "maxLength": 300 }
      }
    },
    "summaryJa": { "type": "string", "maxLength": 900 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishedJst", "productArea", "sourceName", "categories", "importance"],
      "properties": {
        "publishedJst": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "stage": { "type": "string" },
        "productArea": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "roleTags": { "type": "array", "items": { "type": "string" } },
        "roadmapIds": { "type": "array", "items": { "type": "string" } },
        "importance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "score"],
          "properties": {
            "level": { "enum": ["high", "notable", "normal"] },
            "score": { "type": "number" },
            "reasonJa": { "type": "string" }
          }
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "pattern": "^https://" },
        "related": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
