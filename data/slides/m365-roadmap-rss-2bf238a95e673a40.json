      "panels": [
        {
          "id": "how-it-works",
          "heading": "仕組み",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "AL MCP サーバーは、エージェントが AL ワークスペースを操作するためのサーバー", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "ALTool の launchmcpserver コマンドで起動する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "--logfile でログの出力先、--loglevel で詳細レベルを指定する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "--nolog を付けると、ログ出力を完全に無効にできる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits",
          "heading": "既定値と指定できるレベル",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "--logfile 未指定の既定の出力先は ~/.al-mcp/almcp.log（Windows・Linux・macOS 共通）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "レベルは Debug / Verbose / Normal（既定）/ Warning / Error", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "ALMCP", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "related-features",
          "heading": "関連する ALTool の機能",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "AL LSP サーバー（launchlspserver）にも同じ --logfile / --loglevel / --nolog がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "AL LSP", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "--noauth は、外部で認証を行う CI/CD などの無人実行向けのオプション", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "Headless authentication", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "use-case",
          "heading": "活用のヒント",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "障害の調査時は Verbose などに上げ、調査後に Normal へ戻す", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" },
            { "text": "CI/CD では、出力先を固定してビルド成果物と一緒に保管する", "origin": "editorial", "assertion": "recommendation", "verification": "unverified" }
          ]
        }
