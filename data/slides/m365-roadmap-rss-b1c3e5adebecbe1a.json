            { "text": "ゲストと外部出席者は AI 要約にアクセスできない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoftteams/intelligent-recap-without-saving-transcripts", "locator": "FAQ", "retrievedAt": "2026-10-21T01:10:00Z" }] }
