      "qa": [
        {
          "question": "他の拡張機能や依存アプリの ID とは衝突しませんか？",
          "answer": {
            "text": "ツールの走査はアクティブなプロジェクトの構文のみが対象で、依存アプリや同じサンドボックスに発行済みの他の拡張機能の ID は検出されません。ビルド時の確認が必要です。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/al-agent-tools/al-tool-get-next-object-id", "locator": "冒頭", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        },
        {
          "question": "ID の範囲はどう決まりますか？",
          "answer": {
            "text": "既定ではプロジェクトの app.json に宣言された idRanges を使います。rangeStart と rangeEnd で範囲を絞ることもできます。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/al-agent-tools/al-tool-get-next-object-id", "locator": "Parameters", "retrievedAt": "2026-10-22T00:00:00Z" }]
