          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "al_getnextobjectid ツールが、指定した種類の空き ID を返す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/al-agent-tools/al-tool-get-next-object-id", "locator": "冒頭", "retrievedAt": "2026-10-22T00:00:00Z" }] },
