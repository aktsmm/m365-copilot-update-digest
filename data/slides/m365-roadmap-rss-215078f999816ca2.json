        "who": { "text": "**Business Central の AL 開発者**と、環境の管理者", "origin": "mrc", "assertion": "fact", "verification": "source-only" },
        "change": { "text": "断続的な障害や本番環境だけの AL の障害を、エージェントに伝えるだけで記録し、オフラインでデバッグできる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/devenv-snapshot-debugging", "locator": "Snapshot debugging with an AI agent (MCP server)", "retrievedAt": "2026-10-22T00:00:00Z" }] },
