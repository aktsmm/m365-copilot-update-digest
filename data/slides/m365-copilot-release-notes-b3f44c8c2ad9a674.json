      "audience": {
        "who": {
          "text": "**ServiceNow の Copilot コネクタを使う管理者**と、ナレッジ記事やカタログ項目を参照するユーザー",
          "origin": "mrc",
          "assertion": "fact",
          "verification": "source-only"
        },
        "change": {
          "text": "ロールに基づくアクセス制御が一貫し、権限のないコンテンツが表示されにくくなる",
