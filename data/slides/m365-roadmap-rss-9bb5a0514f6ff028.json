            { "text": "DLP ポリシーの場所に「Microsoft 365 Copilot および Copilot Chat」を使う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/purview/dlp-microsoft365-copilot-location-learn-about", "locator": "プロンプトで機密情報の種類をブロックする", "retrievedAt": "2026-10-21T05:00:00Z" }] },
