      "panels": [
        {
          "id": "scope",
          "heading": "2 つのハーネスの違い",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "標準ハーネス：限られたデータやツールでの多段階処理を、一貫して確実に実行",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "標準とGitHub Copilotハーネスの違い", "retrievedAt": "2026-10-22T09:00:00Z"}]
            },
            {
              "text": "GitHub Copilot ハーネス：長時間のタスクや大きなファイル、並列処理、永続メモリに対応",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "標準とGitHub Copilotハーネスの違い", "retrievedAt": "2026-10-22T09:00:00Z"}]
            },
            {
              "text": "推論モデルや一部の新機能は、GitHub Copilot ハーネスでのみ利用可能",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "ハーネス選びの基本原則", "retrievedAt": "2026-10-22T09:00:00Z"}]
            }
          ]
        },
        {
          "id": "constraints",
          "heading": "制約・注意",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "GitHub Copilot ハーネスは使用量ベースの課金で、Copilot クレジットを消費する",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "消費とガバナンスを考えてみましょう", "retrievedAt": "2026-10-22T09:00:00Z"}]
            },
            {
              "text": "単純な課題には過剰で、結果が改善せずクレジット消費や遅延が増えることがある",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "まずシナリオから話しましょう", "retrievedAt": "2026-10-22T09:00:00Z"}]
            },
            {
              "text": "標準ハーネスは、既存の Copilot Studio のライセンスモデルのまま",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "消費とガバナンスを考えてみましょう", "retrievedAt": "2026-10-22T09:00:00Z"}]
            }
          ]
        },
        {
          "id": "impact-check",
          "heading": "移行の考え方",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "正常に動く標準ハーネスのエージェントは、移行不要",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "シナリオレベルの利益のためだけに移行してください", "retrievedAt": "2026-10-22T09:00:00Z"}]
            },
            {
              "text": "移行はコンポーネント変換ではなく再構築として扱う",
              "origin": "learn", "assertion": "fact", "verification": "verified",
              "evidence": [{"url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/choose-harness", "locator": "シナリオレベルの利益のためだけに移行してください", "retrievedAt": "2026-10-22T09:00:00Z"}]
            }
          ]
        },
        {
          "id": "next",
          "heading": "次の一歩",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "まず業務シナリオと想定タスク量を整理し、必要なときだけ移行を検討する",
              "origin": "editorial", "assertion": "recommendation", "verification": "unverified"
            }
          ]
        }
