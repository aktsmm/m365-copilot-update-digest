          "items": [
            {
              "text": "GitHub Copilot ハーネスは使用量ベースの課金。標準ハーネスは既存の Copilot Studio ライセンスモデルを維持",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
