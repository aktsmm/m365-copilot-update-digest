      "qa": [
        {
          "question": "仕入先別の番号系列が未設定の場合、請求書番号はどうなりますか？",
          "answer": { "text": "仕入先側が空欄なら、購買設定の「Posted Self-Billing Inv. Nos.」が使われます。両方とも空欄だとセルフビリング請求書は転記できません。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/purchasing-how-register-new-vendors", "locator": "Set up a self-billing vendor", "retrievedAt": "2026-10-17T00:00:00Z" }] }
        },
        {
          "question": "仕入先別の番号系列は、転記後の請求書の「番号」そのものになりますか？",
          "answer": { "text": "いいえ。仕入先別の系列が割り当てるのは「Vendor Invoice No.」で、転記済み請求書の「No.」は購買設定の通常の Posted Invoice Nos. 系列が使われます。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/purchasing-how-register-new-vendors", "locator": "Set up a self-billing vendor (Note)", "retrievedAt": "2026-10-17T00:00:00Z" }] }
        },
        {
          "question": "仕入先のセルフビリング契約をオフにする際の注意点はありますか？",
          "answer": { "text": "オフにする前に、仕入先カードの「Self-Billing Invoice Nos.」フィールドをクリアしておく必要があります。", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/purchasing-how-register-new-vendors", "locator": "Set up a self-billing vendor", "retrievedAt": "2026-10-17T00:00:00Z" }] }
        }
