            { "text": "Work IQ API のエンドポイントは A2A、リモート MCP サーバー、REST API", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-365/copilot/extensibility/work-iq/", "locator": "Work IQ の概要", "retrievedAt": "2026-10-19T00:00:00Z" }] },
