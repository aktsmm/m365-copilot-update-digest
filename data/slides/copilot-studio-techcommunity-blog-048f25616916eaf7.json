      "qa": [
        {
          "question": "子エージェントと接続エージェントはどう選び分けますか？",
          "answer": {
            "text": "1 つの目的を 1 チームで管理し、個別の設定・発行・再利用が不要なら子エージェントです。個別の発行や専用設定、再利用が必要なら接続エージェントを検討します。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/authoring-add-other-agents", "locator": "子エージェントを使用するタイミング", "retrievedAt": "2026-10-21T08:20:00Z" }]
          }
        },
        {
          "question": "接続エージェントを使うときのガバナンス上の注意は？",
          "answer": {
            "text": "接続エージェントは親がアクセスできないものにアクセスできる場合があります。呼び出しを強力なアクションと同様に扱い、呼び出しの記録も取ります。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/guidance/multi-agent-patterns", "locator": "接続されているエージェント", "retrievedAt": "2026-10-21T08:20:00Z" }]
          }
        },
        {
          "question": "接続エージェントには会話履歴が渡されますか？",
          "answer": {
            "text": "接続エージェントにはコンテキスト包含設定があり、履歴を受け取るかを制御します。自動で渡されると仮定せず設定を確認します。子エージェントは常に親のコンテキストを受け取ります。",
            "origin": "learn",
