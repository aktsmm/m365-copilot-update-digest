      "panels": [
        {
          "id": "how-it-works",
          "heading": "仕組み",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "ビルド中は常に「レビュー」アイコンを表示し、未解決の問題数を示す", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "概要", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "問題を重大度で分類: ブロッキング（公開不可）と警告（公開は可能）", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "重大度レベル", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "各問題にタイトルと説明、「設定の更新」「管理者への連絡」などの操作を表示", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "重大度レベル", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "エージェント作成中、メニュー上部バーのレビュー アイコンを開く", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "概要", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "ブロッキングの問題がなければ、エージェントは公開できる状態", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "重大度レベル", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "ブロックされた項目は無効表示になり、ポイントすると理由を確認できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "ブロックされたツール、コネクター、モデル、スキル", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits",
          "heading": "前提・制限",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "Learn の記事は GitHub Copilot harness を搭載するエージェント向け", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "概要", "retrievedAt": "2026-10-16T00:00:00Z" }] },
            { "text": "管理レベルのガバナンスやコンプライアンス報告の代わりにはならない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoft-copilot-studio/agents-experience/authoring-agent-status", "locator": "概要", "retrievedAt": "2026-10-16T00:00:00Z" }] }
          ]
        },
        {
