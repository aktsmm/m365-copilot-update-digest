            { "text": "音声と顔の登録は GCC まで対応で、GCCH と DoD では利用できない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoftteams/rooms/voice-and-face-recognition", "locator": "よく寄せられる質問", "retrievedAt": "2026-10-18T21:40:00Z" }] }
