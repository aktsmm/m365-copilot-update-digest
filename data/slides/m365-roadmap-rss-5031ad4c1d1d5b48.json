          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "Teams デスクトップ アプリの［設定］>［認識］でオプトインする", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoftteams/rooms/voice-and-face-recognition", "locator": "手順 1: 音声登録と顔認証を有効にする", "retrievedAt": "2026-10-18T21:40:00Z" }] },
