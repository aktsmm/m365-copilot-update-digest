          ]
        },
        {
          "id": "how-to-start",
          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "altool launchmcpserver をプロジェクト パスなしで実行する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/dynamics365/business-central/dev-itpro/developer/al-agent-tools/al-mcp-server", "locator": "Starting the server", "retrievedAt": "2026-10-15T17:00:00Z" }] },
            { "text": "ヘッドレス環境では --noauth で認証プロンプトを省略できる", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "Headless authentication", "retrievedAt": "2026-10-15T17:00:00Z" }] },
            { "text": "接続先は launch.json か BC_SERVER_* 環境変数で指定する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/devenv-al-tool", "locator": "Headless authentication", "retrievedAt": "2026-10-15T17:00:00Z" }] }
