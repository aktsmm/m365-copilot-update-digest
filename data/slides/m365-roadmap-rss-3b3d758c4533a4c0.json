      "panels": [
        {
          "id": "how-it-works",
          "heading": "仕組み",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "請求書が発注書を参照する場合、仕入先と請求書行を特定した後に発注行の一致を提案",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Drafting invoice details", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
              "text": "Business Central が発注行の互換性を確認し、請求数量を割り当てる",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Drafting invoice details", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
              "text": "一致しなかった行は、既存の分類とレビューの流れで処理される",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Drafting invoice details", "retrievedAt": "2026-10-22T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            {
              "text": "Payables Agent をセットアップし、エージェント スーパーバイザーを割り当てる",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Activation and configuration", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
              "text": "購買ドラフトで「発注行の一致」と「警告」を確認し、必要なら「発注行に一致」で修正",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Review proposed matches", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
              "text": "確認後にエージェントがドラフトを未転記の購買請求書として確定する",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Review purchase order matches before finalization", "retrievedAt": "2026-10-22T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "prerequisites-limits",
          "heading": "前提・制限",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "PDF 添付のメールのみ処理。10 ページ超・5 MB 超の PDF は対象外",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Limitations", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
              "text": "検証・サポートは英語のみ。AI の利用は Copilot クレジットで課金される",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/payables-agent", "locator": "Billing for use", "retrievedAt": "2026-10-22T00:00:00Z" }]
            }
          ]
        },
        {
          "id": "related-features",
          "heading": "関連する動作",
          "availability": "present",
          "priority": "detail",
          "items": [
            {
              "text": "警告は Business Central の検証結果で、AI の信頼度ではない",
              "origin": "learn",
              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Understand order-match warnings", "retrievedAt": "2026-10-22T00:00:00Z" }]
            },
            {
