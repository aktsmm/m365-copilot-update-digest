              "assertion": "fact",
              "verification": "verified",
              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Finalize and post the invoice", "retrievedAt": "2026-10-22T00:00:00Z" }]
            }
