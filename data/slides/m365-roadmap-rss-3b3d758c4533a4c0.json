      "qa": [
        {
          "question": "エージェントは請求書を自動で転記しますか？",
          "answer": {
            "text": "いいえ。エージェントは未転記の購買請求書として確定するだけで、転記はしません。転記前に受領の割り当てを確認します。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Finalize and post the invoice", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        },
        {
          "question": "警告をすべて解消しないと確定できませんか？",
          "answer": {
            "text": "いいえ。単位情報の欠落は確定を妨げますが、価格差異や過剰受領などの警告は残したまま確定できます。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Understand order-match warnings", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        },
        {
          "question": "照合できない行はどうなりますか？",
          "answer": {
            "text": "既存の分類とレビューの流れに進みます。運賃や品目チャージなどが自動で照合されるとは限らないため、手動で確認します。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Finalize and post the invoice", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        }
