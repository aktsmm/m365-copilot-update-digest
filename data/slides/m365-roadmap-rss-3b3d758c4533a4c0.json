              "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/match-purchase-invoice-drafts-to-orders", "locator": "Understand order-match warnings", "retrievedAt": "2026-10-22T00:00:00Z" }]
            }
          ]
