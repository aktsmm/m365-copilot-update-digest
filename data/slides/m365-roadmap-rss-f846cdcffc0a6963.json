      "qa": [
        {
          "question": "Data Query Tools は初期状態で有効ですか？",
          "answer": {
            "text": "いいえ。既定の構成では Data Query Tools は「Not activated」で、MCP サーバー構成ページで Activate を選んで有効にします。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/ai/configure-mcp-server", "locator": "Default configuration / Server Features", "retrievedAt": "2026-10-18T21:50:00Z" }]
          }
        },
        {
          "question": "API Tools や動的ツール モードとの違いは何ですか？",
          "answer": {
            "text": "API Tools は公開した API ページ・API クエリを使うのに対し、Data Query Tools はエージェントがデータベースへ直接クエリを実行します。どちらも読み取りに使えますが、データクエリ ツールは作成・変更・削除ができません。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/ai/configure-mcp-server", "locator": "Server Features / Configure data query tools (preview)", "retrievedAt": "2026-10-18T21:50:00Z" }]
          }
        },
        {
          "question": "大量の結果を返すクエリはどう扱いますか？",
          "answer": {
            "text": "bc_data_query には top・skip・resultFormat があり、ページングや大きな結果の扱いに使えます。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/ai/configure-mcp-server", "locator": "Configure data query tools (preview)", "retrievedAt": "2026-10-18T21:50:00Z" }]
