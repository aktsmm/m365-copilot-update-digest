      "panels": [
        {
          "id": "how-it-works",
          "heading": "仕組み",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "Performance Profiling MCP サーバー経由で、エージェントがスケジュール作成から結果の分析まで実行", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Profiling with an AI agent (MCP server)", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "対象時間は既定 5 分、最大 1 時間。終了時に .alcpuprofile と SQL・HTTP の概要を取得", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "ツール一覧", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "セッションの推定メモリ使用量とオブジェクト数も自動で取得される", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Session memory usage", "retrievedAt": "2026-10-15T22:45:00Z" }] }
          ]
        },
        {
          "id": "how-to-start",
          "heading": "使い始めるには",
          "availability": "present",
          "priority": "core",
          "items": [
            { "text": "ALTool の launchprofilingmcpproxy コマンドを MCP ホストに登録する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Part of the Business Central MCP server", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "Visual Studio Code のエージェント モードでは AL 拡張機能が自動登録する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Visual Studio Code", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "対象の数値セッション ID をプロンプトで伝えて依頼する", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Before you start", "retrievedAt": "2026-10-15T22:45:00Z" }] }
          ]
        },
        {
          "id": "prerequisites-limits",
          "heading": "前提・制限",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "環境で Business Central MCP サーバーを有効にする必要がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Permissions", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "他のユーザーのセッションは D365 ATTACH DEBUG 権限セットが必要", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Permissions", "retrievedAt": "2026-10-15T22:45:00Z" }] }
          ]
        },
        {
          "id": "related-features",
          "heading": "既存機能との関係",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "手動の Profiler Schedules と同じエンジンで、取得・保存・分析の仕組みは変わらない", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Profiling with an AI agent (MCP server)", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "取得したプロファイルは VS Code の AL Profiler でも開ける", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Profiling with an AI agent (MCP server)", "retrievedAt": "2026-10-15T22:45:00Z" }] }
          ]
        },
        {
          "id": "use-case",
          "heading": "利用上の注意",
          "availability": "present",
          "priority": "detail",
          "items": [
            { "text": "プロファイル中は対象ユーザーの AL 実行にのみ約 10% のオーバーヘッド", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "FAQ", "retrievedAt": "2026-10-15T22:45:00Z" }] },
            { "text": "保存されたローカル ファイルには機微な業務データが含まれ得るため、安全に取り扱う", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/administration/scheduled-performance-profiler-overview", "locator": "Profiling with an AI agent (MCP server)", "retrievedAt": "2026-10-15T22:45:00Z" }] }
          ]
        }
