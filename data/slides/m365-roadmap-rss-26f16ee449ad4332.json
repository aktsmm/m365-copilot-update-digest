      "qa": [
        {
          "question": "ルールとポリシーの違いは何ですか？",
          "answer": {
            "text": "ルールは測定可能な条件を Business Central が確認します。ポリシーは自然言語で記述し、AI が評価します。両者は独立しており、ルールを満たしてもポリシーで指摘されることがあります。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/expense-management/expense-agent-policy-compliance", "locator": "Understand the difference between rules and policies", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        },
        {
          "question": "評価が終わらない場合、提出や承認は止まりますか？",
          "answer": {
            "text": "現行の仕様では、評価を開始・完了できなくても提出は続行でき、該当の経費は「Policies pending」と表示されます。承認者は結果が最新でない旨の警告を見て、待つか承認を続けるか選べます。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
            "evidence": [{ "url": "https://learn.microsoft.com/en-us/dynamics365/business-central/expense-management/expense-agent-policy-compliance", "locator": "Keep evaluation results current", "retrievedAt": "2026-10-22T00:00:00Z" }]
          }
        },
        {
          "question": "AI に渡される情報にメールアドレスは含まれますか？",
          "answer": {
            "text": "いいえ。評価に必要な情報のみが送られ、参加者のメールアドレスと従業員番号は AI の入力から除かれます。",
            "origin": "learn",
            "assertion": "fact",
            "verification": "verified",
