            { "text": "適用時、デバイスはオンラインでアプリにサインイン済みである必要がある", "origin": "learn", "assertion": "fact", "verification": "verified", "evidence": [{ "url": "https://learn.microsoft.com/ja-jp/microsoftteams/rooms/digital-signage", "locator": "手順 4", "retrievedAt": "2026-10-18T22:47:00Z" }] }
